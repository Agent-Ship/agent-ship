# Keep the build context lean — the image installs the packages and serves ./examples.
.venv/
**/.venv/
.git/
**/__pycache__/
**/*.pyc
.pytest_cache/
**/.pytest_cache/
**/tests/
conformance/
.spec-dev/
*.egg-info/
**/*.egg-info/
.ruff_cache/
docs/
site/
postman/
scripts/

# Never ship a real .env into the image — variables come from the platform.
.env
