# AgentShip demo — provider credentials template.
#
#   cp .env.example .env
#   # then edit .env and fill in your real key
#
# The `agentship run` CLI (and `make demo`) load a `.env` from the current directory
# automatically, so running an agent picks up the key set here. This file
# (.env.example) is the committed template; the filled-in `.env` is gitignored and
# must never be committed.
#
# This demo is LIVE: every agent (agents/*.yaml) uses openai/gpt-4o-mini and every
# `make demo` / `make test` run calls the real OpenAI API, so you need a real key:
#
OPENAI_API_KEY=sk-...

# --- Phase 07 observability read-back (optional) ---
# The observability slice (agents/observability.yaml, tests/test_observability.py) exports a full
# trace and reads it back from each hosted backend's own API. All three are HOSTED — API keys, none
# self-deployed. Set only the ones you want to prove; each backend's live test skips when its keys
# are absent, so the suite never fake-passes. Keys are read from the environment, never from YAML.

# Opik (Comet) — https://www.comet.com/opik
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=agentship-observability
# OPIK_OTEL_ENDPOINT=          # only for a self-hosted Opik server

# LangFuse — https://cloud.langfuse.com  (project settings → API keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=               # optional; defaults to https://cloud.langfuse.com

# LangSmith — https://smith.langchain.com  (ships spans off-box → allow_saas_exporter: true)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentship-observability
