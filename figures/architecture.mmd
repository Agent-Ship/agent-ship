%% Figure 1 — C4 Level 1 (System Context): AgentShip in its environment.
%% -
%% Render:
%%   mmdc -i figures/architecture.mmd -o figures/architecture.png \
%%        -b white -s 3 -c figures/mermaid-config.json
%% -
%% Shared notation across all three figures:
%%   amber   = person          green = AgentShip (ours)      grey  = external system
%%   violet  = speech provider blue  = state / datastore     pink  = observability
%%   dashed border + "[planned]" = specified but NOT yet implemented. Marked rather than
%%   omitted so the architecture reads whole, and rather than drawn solid so the figure
%%   never claims software that does not exist.
%% -
%% Every node carries black text on a pastel fill with a same-hue border, so the figure
%% survives greyscale printing: the shapes stay distinguishable by border weight and the
%% labels stay legible at column width.
flowchart TB
  classDef person  fill:#FDE68A,stroke:#B45309,stroke-width:2px,color:#000000
  classDef system  fill:#A7F3D0,stroke:#047857,stroke-width:3px,color:#000000
  classDef ext     fill:#E5E7EB,stroke:#4B5563,stroke-width:2px,color:#000000
  classDef voice   fill:#DDD6FE,stroke:#6D28D9,stroke-width:2px,color:#000000
  classDef store   fill:#BFDBFE,stroke:#1D4ED8,stroke-width:2px,color:#000000
  classDef obs     fill:#FBCFE8,stroke:#BE185D,stroke-width:2px,color:#000000
  classDef planned fill:#F8FAFC,stroke:#94A3B8,stroke-width:2px,stroke-dasharray:6 4,color:#000000

  subgraph PEOPLE["Who uses it"]
    direction LR
    P1["<b>Practitioner</b><br/><i>[Person]</i><br/>Authors an AgentSpec"]:::person
    P2["<b>End user</b><br/><i>[Person]</i><br/>Speaks or calls the API"]:::person
  end

  SYS["<b>AgentShip</b><br/><i>[Software System]</i><br/>Declarative integration layer<br/>for the agentic harness"]:::system

  subgraph REASON["Reasoning and tools"]
    direction LR
    E1["<b>LLM providers</b><br/><i>[External, via LiteLLM]</i>"]:::ext
    E2["<b>MCP servers</b><br/><i>[External]</i><br/>local stdio or remote"]:::ext
    E3["<b>Identity provider</b><br/><i>[External, OIDC]</i>"]:::ext
  end

  subgraph SPEECH["Speech"]
    direction LR
    V1["<b>Speech-to-text</b><br/><i>[External, streaming]</i><br/>Deepgram, 7 others"]:::voice
    V2["<b>Text-to-speech</b><br/><i>[External, streaming]</i><br/>Cartesia, 7 others"]:::voice
  end

  subgraph STATE["State and telemetry"]
    direction LR
    M1["<b>Conversation store</b><br/><i>[Checkpoints]</i><br/>Postgres or in-memory"]:::store
    O1["<b>Tracing backends</b><br/><i>[External, OTLP]</i><br/>Phoenix, Langfuse,<br/>LangSmith, Opik"]:::obs
    M2["<b>Long-term memory</b><br/><i>[planned]</i>"]:::planned
  end

  P1 -->|"declares a harness in YAML"| SYS
  P2 -->|"speaks or calls /v1"| SYS

  SYS -->|"routes model calls"| E1
  SYS -->|"binds tools"| E2
  SYS -->|"validates callers"| E3
  SYS -->|"streams audio in"| V1
  SYS -->|"streams audio out"| V2
  SYS -->|"checkpoints turns"| M1
  SYS -->|"emits one trace per turn"| O1
  SYS -.->|"recalls facts"| M2

