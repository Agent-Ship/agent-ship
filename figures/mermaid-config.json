    "signalColor": "#334155",
    "signalTextColor": "#000000",
    "labelBoxBkgColor": "#FDE68A",
    "labelBoxBorderColor": "#B45309",
    "labelTextColor": "#000000",
    "loopTextColor": "#000000",
    "noteBkgColor": "#FEF3C7",
    "noteBorderColor": "#B45309",
