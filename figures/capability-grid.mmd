%% Figure 2 — C4 Level 2 (Containers): the seven installable packages.
%% -
%% Render:
%%   mmdc -i figures/capability-grid.mmd -o figures/capability-grid.png \
%%        -b white -s 3 -c figures/mermaid-config.json
%% -
%% Notation matches Figure 1. Every container shown here is a package that EXISTS and is
%% published; the previous version of this figure drew `agentship-eval` and
%% `agentship-memory` as containers, and neither has been written. A paper figure claiming
%% software that does not exist is the one mistake a reviewer is certain to catch, so
%% planned work is stated in the text instead of drawn as though it shipped.
%% -
%% Layout is deliberately layered rather than free: callers on top, the kernel at the
%% bottom, adapters between. The earlier free layout crossed twenty edges over eight
%% containers and could not be read at any print size.
flowchart TB
  classDef person  fill:#FDE68A,stroke:#B45309,stroke-width:2px,color:#000000
  classDef kernel  fill:#A7F3D0,stroke:#047857,stroke-width:3px,color:#000000
  classDef pkg     fill:#CCFBF1,stroke:#0F766E,stroke-width:2px,color:#000000
  classDef voice   fill:#DDD6FE,stroke:#6D28D9,stroke-width:2px,color:#000000
  classDef obs     fill:#FBCFE8,stroke:#BE185D,stroke-width:2px,color:#000000
  classDef ext     fill:#E5E7EB,stroke:#4B5563,stroke-width:2px,color:#000000

  P1["<b>Practitioner</b><br/><i>[Person]</i>"]:::person
  P2["<b>End user</b><br/><i>[Person]</i>"]:::person

  subgraph SYS["AgentShip [Software System] — one monorepo, seven published packages"]
    direction TB

    subgraph ENTRY["Entry points"]
      direction LR
      CLI["<b>agentship-cli</b><br/><i>[Container]</i><br/>run · serve · verify<br/>doctor · voice"]:::pkg
      SVC["<b>agentship-service</b><br/><i>[Container: FastAPI]</i><br/>REST · SSE · WebSocket<br/>auth · tenant scope · Studio"]:::pkg
      VOI["<b>agentship-voice</b><br/><i>[Container]</i><br/>VAD → STT → agent → TTS<br/>barge-in · latency trace<br/><i>hosts on Pipecat or LiveKit</i>"]:::voice
    end

    subgraph ADAPT["Adapters"]
      direction LR
      ENG["<b>agentship-langgraph</b><br/><i>[Container: reference engine]</i><br/>compiles AgentSpec into a StateGraph<br/><i>wraps LangGraph · LiteLLM ·<br/>langchain-mcp-adapters · Postgres</i>"]:::pkg
      OBS["<b>agentship-observability</b><br/><i>[Container: OTel pipeline]</i><br/>agent → node → model → tool<br/><i>exports OTLP to Phoenix · Langfuse ·<br/>LangSmith · Opik</i>"]:::obs
    end

    CORE["<b>agentship-core</b><br/><i>[Container: vendor-neutral kernel]</i><br/>AgentSpec · RunContext · Engine ABC + EngineCapabilities<br/>Tool · middleware · Observer seam · conformance grid<br/><b>imports no vendor</b>"]:::kernel

    SDK["<b>agentship-sdk</b><br/><i>[Meta-package]</i><br/>installs the stack"]:::pkg
  end


  P1 -->|"authors YAML, runs the CLI"| CLI
  P2 -->|"HTTP or WebSocket"| SVC
  P2 -->|"speaks"| VOI

  CLI -->|"builds and serves"| CORE
  SVC -->|"delegates each turn"| ENG
  SVC -->|"hosts the voice socket"| VOI
  VOI -->|"calls the same agent"| ENG
  ENG -->|"implements Engine ABC"| CORE
  OBS -->|"implements Observer seam"| CORE
  SDK -.->|"depends on all six"| CORE

